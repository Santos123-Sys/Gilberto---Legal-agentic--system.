# ─────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES
#  Copy to backend/.env and fill in values
# ─────────────────────────────────────────────

# Maritaca AI API Key (get at plataforma.maritaca.ai)
MARITACA_API_KEY=your_maritaca_key_here

# Maritaca endpoint (do not change unless using a different base)
MARITACA_BASE_URL=https://chat.maritaca.ai/api

# Model to use (sabia-4 is the flagship; sabiazinho-4 is cheaper/faster)
MARITACA_MODEL=sabia-4

# Agent/round limits (safety caps)
MAX_MODEL_CALLS=250
MAX_ROUNDS=3

# Stagger Maritaca calls to stay under per-minute quotas.
LLM_MAX_CONCURRENT_CALLS=1
LLM_MIN_REQUEST_INTERVAL_SECONDS=2.0
LLM_INPUT_TOKENS_PER_MINUTE=10000

# FastAPI server
PORT=8000

# CORS origins — set to your Railway frontend URL in production
# In production replace this with the exact HTTPS frontend origin. Never use *
# together with credentialed cross-origin requests.
# e.g. CORS_ORIGINS=https://your-frontend.railway.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
#  FRONTEND ENVIRONMENT VARIABLES
#  Copy to frontend/.env and fill in values
# ─────────────────────────────────────────────

# URL of your deployed backend (Railway backend service URL)
# e.g. VITE_API_URL=https://your-backend.railway.app
VITE_API_URL=http://localhost:8000


# Bounded review execution (initial call budget is enforced server-side)
MAX_FEEDBACK_ROUNDS=2
LLM_REQUEST_TIMEOUT_SECONDS=120
# Upload cap is presently fixed at 10 MiB in backend/config.py.

# INVITE-ONLY LOCAL IDENTITY (alternative to OIDC)
# Backend: AUTH_MODE=local, IDENTITY_DB_PATH=/data/identity.sqlite3
# Backend: LOCAL_AUTH_APP_ORIGIN=https://your-frontend.up.railway.app
# Backend: LOCAL_AUTH_PROXY_SECRET=<strong-random-secret-over-32-characters>
# Backend: LOCAL_AUTH_COOKIE_SECURE=true
# Frontend Vite BUILD ARG: VITE_AUTH_MODE=local
# Frontend RUNTIME: GILBERTO_API_UPSTREAM=https://your-backend.up.railway.app
# Frontend RUNTIME: GILBERTO_PROXY_SECRET=<same-secret-as-backend>
# Admin shell, never pass passwords on CLI: python -m security.local_identity create-user --email admin@example.com
